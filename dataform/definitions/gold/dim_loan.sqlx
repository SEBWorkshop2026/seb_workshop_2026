config {
  type: "incremental",
  schema: "gold",
  bigquery: {
    partitionBy: "DATE_TRUNC(reporting_date, MONTH)"
  }
}

pre_operations {
  ${when(incremental(), `DELETE FROM ${self()} WHERE reporting_date = DATE '${reportingDate()}'`)}
}

SELECT
  loan_id,
  reporting_date,
  type_of_loan,
  reason_for_loan,
  initial_credit_limit,
  currency,
  origination_date,
  maturity_date
FROM ${ref("silver", "arrangement_account_info")}
WHERE reporting_date = DATE '${reportingDate()}'
