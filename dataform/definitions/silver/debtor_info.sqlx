config {
  type: "incremental",
  schema: "silver",
  bigquery: {
    partitionBy: "DATE_TRUNC(reporting_date, MONTH)"
  }
}

pre_operations {
  ${when(incremental(), `DELETE FROM ${self()} WHERE reporting_date = DATE '${reportingDate()}'`)}
}

SELECT
  debtor_identifier AS debtor_id,
  reporting_date,
  age,
  sex,
  education,
  politically_exposed,
  underage_children_count,
  family_status,
  residence_region
FROM ${ref("bronze", "debtor_info")}
WHERE reporting_date = DATE '${reportingDate()}'
