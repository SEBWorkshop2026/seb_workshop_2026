config {
  type: "incremental",
  schema: "silver",
  dependencies: ["create_datasets"],
  bigquery: {
    partitionBy: "DATE_TRUNC(reporting_date, MONTH)"
  }
}

pre_operations {
  ${when(incremental(), `DELETE FROM ${self()} WHERE reporting_date = DATE '${reportingDate()}'`)}
}

WITH loans AS (
  SELECT loan_id, debtor_id, co_debtor_id, reporting_date
  FROM ${ref("bronze", "arrangement_account_info")}
  WHERE reporting_date = DATE '${reportingDate()}'
)

SELECT loan_id, debtor_id, 'primary' AS role, reporting_date
FROM loans
UNION ALL
SELECT loan_id, co_debtor_id AS debtor_id, 'co' AS role, reporting_date
FROM loans
WHERE co_debtor_id IS NOT NULL
