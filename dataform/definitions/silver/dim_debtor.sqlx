config {
  type: "incremental",
  schema: "silver",
  dependencies: ["create_datasets"],
  bigquery: {
    partitionBy: "DATE_TRUNC(reporting_date, MONTH)"
  }
}

pre_operations {
  ${when(incremental(), `DELETE FROM ${self()} WHERE reporting_date = DATE '${reportingDate()}'`)}
}

SELECT
  d.debtor_identifier AS debtor_id,
  d.reporting_date,
  d.age,
  d.sex,
  d.education,
  d.politically_exposed,
  d.underage_children_count,
  d.family_status,
  d.residence_region,
  f.income,
  f.funds_available,
  f.currency,
  f.credit_rating,
  f.household_income,
  f.employment_industry,
  f.proposed_risk_class
FROM ${ref("bronze", "debtor_info")} d
LEFT JOIN ${ref("bronze", "debtor_financial")} f
  ON d.debtor_identifier = f.debtor_identifier
  AND d.reporting_date = f.reporting_date
WHERE d.reporting_date = DATE '${reportingDate()}'
